{
  "name": "hubuno",
  "version": "1.0.0",
  "private": true,
  "description": "Hub de jeux de société en ligne pour la classe, avec messagerie.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test src/*.test.js games/*/rules.test.js games/poker/hands.test.js",
    "test:parcours": "node --test --test-concurrency=2 tests/parcours/*.test.mjs",
    "test:parcours:tel": "TOUS_LES_JEUX=1 TELEPHONE=1 node --test tests/parcours/tous-les-jeux.test.mjs",
    "test:parcours:tous": "TOUS_LES_JEUX=1 node --test tests/parcours/tous-les-jeux.test.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
